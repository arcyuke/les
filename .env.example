PORT=3000
# Personal information must be kept on a persistent server disk, never in GitHub.
BOOKINGS_ENABLED=false
GITHUB_REPOSITORY=arcyuke/les
TELEGRAM_BOT_TOKEN=
# Comma-separated exact website origins; set before enabling online requests.
ALLOWED_ORIGINS=https://your-domain.example
# Mount a persistent disk here. Do not store it inside the public dist directory.
DATA_DIR=.runtime
